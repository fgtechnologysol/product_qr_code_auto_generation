<odoo>
    <data>
        <record id="product_template_form_extend_updated" model="ir.ui.view">
            <field name="name">product.template.form.extend.updated</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="image_name" invisible="1"/>
                    <field name="qr_image" widget="image"/>
                    <button name="download_image_field_prod_temp" class="btn-primary" type="object" string="Download Image"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>